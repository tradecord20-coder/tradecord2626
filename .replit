modules = ["nodejs-20", "web-v2", "python-3.11"]

# जब आप Replit में 'Run' बटन दबाएंगे, तब यह कमांड चलेगी
run = "fuser -k 3000/tcp 5001/tcp 2>/dev/null || true; (python3 tradecore/app.py > /dev/null 2>&1 &) && pnpm dev --port 3000 --host 0.0.0.0"

[deployment]
# यह कमांड Replit पर पब्लिश (Deploy) करते समय ऐप को पोर्ट 3000 पर लॉक रखेगी
run = "fuser -k 3000/tcp 5001/tcp 2>/dev/null || true; (python3 tradecore/app.py > /dev/null 2>&1 &) && pnpm dev --port 3000 --host 0.0.0.0"
build = "pnpm install && pnpm build"
deploymentTarget = "cloudrun"

[nix]
channel = "stable-25_05"
packages = ["yakut", "psmisc"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 8080
