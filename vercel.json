{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/artifacts/tradecore/dist/$1" },
    { "src": "/.*", "dest": "/artifacts/tradecore/dist/index.html" }
  ]
}
